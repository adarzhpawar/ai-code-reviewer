# Backend Environment Variables - Local Development
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000

# API Keys
# Get your Featherless AI API key from: https://featherless.ai
# Sign up -> API Keys -> Create new key
FEATHERLESS_API_KEY=rc_your_api_key_here

# CORS Configuration (comma-separated list of allowed origins)
# For local development, allow multiple ports for different dev environments
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:3005,http://localhost:3006

# Optional: Enable debug mode
# DEBUG=true
